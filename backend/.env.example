# Modèle de configuration (sans secrets réels)
# Copier ce fichier en .env pour le développement local : cp .env.example .env

NODE_ENV=development
PORT=3000

# Base de données PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=outing_user
DB_PASSWORD=changeme_local_password
DB_NAME=outing_db

# Redis (Cache & Pub/Sub WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
